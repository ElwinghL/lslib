<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyTitle>LSLib - Divine Commandline Tool</AssemblyTitle>
    <Product>LSLib</Product>
    <AssemblyVersion>1.15.14.0</AssemblyVersion>
    <FileVersion>1.15.14.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\LSLib\LSLib.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      BG3Tools fork scope reduction (fix/LSLibForkBuildLinux): CommandLineGR2Processor
      wires up the convert-model/convert-models CLI actions (GR2 mesh/animation
      conversion), which depend on LSLib's Granny/GR2 code — excluded from LSLib.csproj
      because it needs the native, MSVC-only LSLibNative library. Those two actions were
      also removed from CommandLineArguments/CommandLineActions (see those files), so
      this file is now dead code; excluded here rather than deleted so a future
      maintainer can restore GR2 support by reverting both without hunting for the file.
    -->
    <Compile Remove="CLI\CommandLineGR2Processor.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommandLineArgumentsParser" Version="3.0.23" />
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
  </ItemGroup>
</Project>